+  function renderMinimapRadar() {
+    const canvas = document.getElementById("hudMinimap");
+    if (!canvas) return;
+    const mctx = canvas.getContext("2d");
+    if (!mctx) return;
+
+    const mw = canvas.width;
+    const mh = canvas.height;
+    const cx = mw / 2;
+    const cy = mh / 2;
+    const now = performance.now() * 0.001;
+
+    mctx.clearRect(0, 0, mw, mh);
+
+    // Radar Grid Circles
+    mctx.strokeStyle = "rgba(94, 234, 212, 0.25)";
+    mctx.lineWidth = 1;
+    mctx.beginPath();
+    mctx.arc(cx, cy, 18, 0, Math.PI * 2);
+    mctx.stroke();
+
+    mctx.beginPath();
+    mctx.arc(cx, cy, 38, 0, Math.PI * 2);
+    mctx.stroke();
+
+    // Radar Sweep Line
+    const sweepAngle = (now * 1.8) % (Math.PI * 2);
+    mctx.save();
+    mctx.beginPath();
+    mctx.moveTo(cx, cy);
+    mctx.arc(cx, cy, 46, sweepAngle - 0.35, sweepAngle);
+    mctx.fillStyle = "rgba(94, 234, 212, 0.15)";
+    mctx.fill();
+    mctx.restore();
+
+    // Center Hub Blip (Orbital Station)
+    mctx.beginPath();
+    mctx.arc(cx, cy, 3.5, 0, Math.PI * 2);
+    mctx.fillStyle = "#5eead4";
+    mctx.shadowColor = "#5eead4";
+    mctx.shadowBlur = 6;
+    mctx.fill();
+    mctx.shadowBlur = 0;
+
+    // Sector Blips: S1 Terra (top-left), S2 Marte (top-right), S3 Saturno (bottom-left), S4 Gargântua (bottom-right)
+    const sectors = [
+      { name: "Terra", x: cx - 26, y: cy - 20, color: "#6ea8fe" },
+      { name: "Marte", x: cx + 26, y: cy - 20, color: "#ef4444" },
+      { name: "Saturno", x: cx - 26, y: cy + 20, color: "#fbbf24" },
+      { name: "Gargântua", x: cx + 26, y: cy + 20, color: "#c084fc" }
+    ];
+
+    sectors.forEach((s) => {
+      mctx.beginPath();
+      mctx.arc(s.x, s.y, 2.8, 0, Math.PI * 2);
+      mctx.fillStyle = s.color;
+      mctx.fill();
+    });
+
+    minimapAnimId = requestAnimationFrame(renderMinimapRadar);
+  }
+
